{
  "expo": {
    "name": "RoadReport",
    "slug": "RoadReport",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "roadreport",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.rishi919.roadreport",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyRoadReportDefaultKeyForVivaAndOffline"
        }
      },
      "permissions": [
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow RoadReport to access your location to report civic issues."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RoadReport to access your camera to capture issue photos.",
          "microphonePermission": "Allow RoadReport to access your microphone to record issue videos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RoadReport to access your photo gallery to upload issue photos."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8bc602df-7aeb-4ed2-81f0-43582f0c9e25"
      }
    },
    "owner": "rishi919"
  }
}
